# ============================================================
#  FAKE NEWS DETECTOR - ENVIRONMENT TEMPLATE
#  Copy this file to `.env` and fill in your API key.
#  The `.env` file is gitignored and will NOT be uploaded.
#
#  Get your free Gemini API key at: https://aistudio.google.com/
# ============================================================

# Primary AI provider: gemini or openrouter
AI_PROVIDER=gemini

# Your Google Gemini API key
GEMINI_API_KEY=YOUR_API_KEY_HERE

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Optional free fallback using OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Server port (optional, defaults to 3000)
PORT=3000
